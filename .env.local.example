# Copy this file to .env.local and fill in the values

# Backend API — never use NEXT_PUBLIC_ for these
ADMIN_API_KEY=your_backend_admin_api_key_here
BACKEND_API_BASE_URL=https://your-app.fly.dev

# Admin dashboard login password
ADMIN_DASHBOARD_PASSWORD=your_secure_dashboard_password

# Session signing secret — generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=your_64_char_hex_secret_here

# ── WhatsApp Webhook ─────────────────────────────────────────────────────────
# Token you set in the Meta developer console for webhook verification
META_VERIFY_TOKEN=your_verify_token_here

# App secret from Meta developer console (for HMAC signature check)
META_APP_SECRET=your_meta_app_secret_here

# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── TEST_MODE ────────────────────────────────────────────────────────────────
# Set to true to skip MongoDB and use in-memory stub data (for local smoke-testing)
TEST_MODE=false

# Required only when TEST_MODE=true — copy from Meta developer console
TEST_PHONE_NUMBER_ID=your_phone_number_id
TEST_WABA_ID=your_waba_id
TEST_META_TOKEN=your_meta_access_token

# ── Production MongoDB (not needed when TEST_MODE=true) ──────────────────────
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
